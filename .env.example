# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Comma-separated emails that get admin access (/admin — user management + usage dashboard).
# Every other logged-in user is a regular user. No spaces needed around commas.
ADMIN_EMAILS=you@example.com,teammate@example.com

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# Moonshot AI (Kimi K3) — called directly, bypassing Vercel AI Gateway.
# https://platform.kimi.ai (or platform.moonshot.ai)
OPENAI_API_KEY=****
OPENAI_BASE_URL=https://api.moonshot.ai/v1

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Sanity write token (Editor role) with access to every project listed in
# lib/sanity/projects.ts — either a per-org personal token (`npx sanity debug --secrets`)
# or a token you create under a specific project's API > Tokens page.
SANITY_API_TOKEN=****

# Shared Google Search Console service account (one for ALL sites — per-site access is
# granted by adding this service account's email as a user on each site's Search Console
# property, not via separate credentials). From a Google Cloud service account JSON key:
# https://console.cloud.google.com -> APIs & Services -> Credentials -> Create Service Account
# Enable the "Google Search Console API" on that project first.
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=****@****.iam.gserviceaccount.com
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n****\n-----END PRIVATE KEY-----\n"